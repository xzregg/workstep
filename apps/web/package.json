{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-language-catalog.mjs && tsc -b && vite build",
    "build:gateway-share": "node scripts/generate-language-catalog.mjs && tsc -b && vite build --mode gateway-share",
    "lint": "oxlint",
    "preview": "vite preview",
