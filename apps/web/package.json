    "@ag-ui/core": "^0.0.57",
    "@vladmandic/human": "3.3.6",
    "@workstep/gateway-ui": "file:../../packages/gateway-ui",
    "@xyflow/react": "^12.11.2",
    "antd": "^6.6.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.29.0",
    "mermaid": "^11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.71.0",
    "tsx": "^4.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "resolutions": {
    "dompurify": "^3.4.17",
    "mermaid/katex": "^0.18.2"
