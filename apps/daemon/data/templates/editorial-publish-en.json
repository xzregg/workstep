        "engine": "hermes",
        "model": "",
        "prompt": "Perform final publication checks: confirm all review comments are addressed, check rendering across devices, verify links and multimedia access, and set publication time (immediate/scheduled). Publish to content platforms and distribute simultaneously to social media, email, and RSS.",
        "review": {
          "auto": false,
