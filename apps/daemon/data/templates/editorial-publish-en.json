        "outputs": [
          {
            "name": "Layout files",
            "type": "file"
          },
          {
            "name": "Illustration plan",
            "type": "json"
          }
        ]
      },
      {
        "id": 6,
        "type": "publish",
        "title": "Final review and publication",
        "position": {
          "x": 1280,
          "y": 200
