        "title": "市场调研",
        "position": {
          "x": 80,
          "y": 200
        },
        "engine": "claude",
        "model": "",
        "prompt": "进行营销活动前市场调研：分析目标受众画像和行为特征、竞品近期营销动向和策略、市场趋势和季节性因素。产出市场调研报告和受众洞察（含触媒习惯、内容偏好、决策路径）。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
