          "auto": false,
          "maxRetries": 2,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "Legal review comments",
            "type": "file",
            "outputs": [
              {
                "name": "Revised contract",
                "type": "Markdown"
              },
              {
                "name": "Response notes",
                "type": "file"
              }
            ]
          },
          {
            "name": "Commercial review comments",
            "type": "file",
            "outputs": []
          }
