{
  "id": "legal-contract-en",
  "default": true,
  "name": "Contract management",
  "description": "Contract drafting → Legal review → Signing → Archiving",
  "steps": {
    "nodes": [
      {
        "id": 1,
        "type": "contract_draft",
        "title": "Contract drafting",
        "position": {
          "x": 80,
          "y": 200
        },
        "engine": "claude",
        "model": "",
        "prompt": "Draft a contract based on business requirements and contract type (purchase/sale/service/NDA/partnership, etc.): select a suitable template, fill in key clauses (subject matter, amount, payment terms, delivery standards, liability, dispute resolution), and mark negotiable and legally mandatory clauses. Produce a contract draft and clause list.",
        "review": {
          "auto": false,
          "maxRetries": 2,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "Business requirements",
            "type": "Document",
            "outputs": [
              {
                "name": "Contract draft",
                "type": "Markdown"
              },
              {
                "name": "Clause list",
                "type": "json"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "Contract draft",
            "type": "Markdown"
          },
          {
            "name": "Clause list",
            "type": "json"
          }
        ]
      },
      {
        "id": 2,
        "type": "legal_review",
        "title": "Legal review",
        "position": {
          "x": 380,
          "y": 120
        },
        "engine": "claude",
        "model": "",
        "prompt": "Have the legal team review contract clauses: check legality and compliance (contract law/civil code/industry regulations), identify legal risks and assign high/medium/low risk levels, and review intellectual property and data protection clauses. Produce legal review comments and a risk matrix.",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "Contract draft",
            "type": "Markdown",
            "outputs": [
              {
                "name": "Legal review comments",
                "type": "file"
              },
              {
                "name": "Risk matrix",
                "type": "json"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "Legal review comments",
            "type": "file"
          },
          {
            "name": "Risk matrix",
            "type": "json"
          }
        ]
      },
      {
        "id": 3,
        "type": "commercial_review",
        "title": "Commercial review",
        "position": {
          "x": 380,
          "y": 300
        },
        "engine": "claude",
        "model": "",
        "prompt": "Have the commercial team review commercial terms: verify pricing and payment terms, assess feasibility of delivery schedules and acceptance criteria, and review whether liability and damages caps are acceptable. Produce commercial review comments and negotiation strategy recommendations.",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "Contract draft",
            "type": "Markdown",
            "outputs": [
              {
                "name": "Commercial review comments",
                "type": "file"
              },
              {
                "name": "Negotiation strategy",
                "type": "file"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "Commercial review comments",
            "type": "file"
          },
          {
            "name": "Negotiation strategy",
            "type": "file"
          }
        ]
      },
      {
        "id": 4,
        "type": "revision",
        "title": "Clause revision",
        "position": {
          "x": 680,
          "y": 200
        },
        "engine": "claude",
        "model": "",
        "prompt": "Consolidate legal and commercial review comments and revise the clauses: merge proposed changes, mark revisions using tracked changes, and offer alternatives for disputed clauses. Produce a revised contract and point-by-point responses to review comments.",
