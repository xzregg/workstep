        "inputs": [
          {
            "name": "回顾报告",
            "type": "file",
            "outputs": [
              {
                "name": "自评报告",
                "type": "file"
              },
              {
                "name": "360 反馈",
                "type": "json"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "自评报告",
            "type": "file"
          },
          {
            "name": "360 反馈",
            "type": "json"
          }
        ]
      },
