        "model": "",
        "prompt": "组织绩效校准会议：横向对比各部门绩效分布确保公平性、讨论边界案例和争议评级、确定强制分布比例。产出校准后的绩效结果汇总和各部门绩效分布报告。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
