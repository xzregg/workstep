        "title": "员工自评",
        "position": {
          "x": 680,
          "y": 80
        },
        "engine": "claude",
        "model": "",
        "prompt": "引导员工完成自评：逐项对照绩效目标进行自评打分、总结关键成果和亮点、反思不足和成长空间、提出下一周期发展目标。产出员工自评报告和 360 度反馈收集计划（同事/下属/跨部门协作方）。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
