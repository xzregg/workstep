        "type": "manager_evaluation",
        "title": "上级评估",
        "position": {
          "x": 680,
          "y": 260
        },
        "engine": "claude",
        "model": "",
        "prompt": "直属上级完成绩效评估：基于实际数据（而非主观印象）逐项评分、结合 360 度反馈和多维度评估（业绩达成+能力成长+价值观匹配+团队贡献）形成综合判断。产出上级评估报告和绩效等级建议（S/A/B/C/D）。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "自评报告",
            "type": "file",
            "outputs": [
