{
  "id": "hr-performance",
  "default": true,
  "name": "绩效考核",
  "description": "目标设定 → 过程跟踪 → 评估 → 反馈",
  "steps": {
    "nodes": [
      {
        "id": 1,
        "type": "goal_setting",
        "title": "目标设定",
        "position": {
          "x": 80,
          "y": 200
        },
        "engine": "claude",
        "model": "",
        "prompt": "启动绩效考核周期的目标设定：对齐公司战略目标逐层拆解至部门和个人，按 OKR 或 KPI 框架制定可量化指标。产出个人绩效目标表（含权重、评分标准、数据来源），确保目标符合 SMART 原则并通过上级确认。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "战略目标",
            "type": "Markdown",
            "outputs": [
              {
                "name": "绩效目标表",
                "type": "json"
              },
              {
                "name": "OKR 对齐",
                "type": "file"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "绩效目标表",
            "type": "json"
          },
          {
            "name": "OKR 对齐",
            "type": "file"
          }
        ]
      },
      {
        "id": 2,
        "type": "mid_review",
        "title": "中期回顾",
        "position": {
          "x": 380,
          "y": 200
        },
        "engine": "claude",
        "model": "",
        "prompt": "进行中期绩效回顾：对比实际完成进度与目标的偏差分析、识别阻塞因素和资源缺口、评估是否需要目标调整。产出中期回顾报告（进度评分、风险预警、下半周期改进计划），安排一对一反馈面谈。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "绩效目标表",
            "type": "json",
            "outputs": [
              {
                "name": "回顾报告",
                "type": "file"
              },
              {
                "name": "改进计划",
                "type": "file"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "回顾报告",
            "type": "file"
          },
          {
            "name": "改进计划",
            "type": "file"
          }
        ]
      },
