{
  "id": "hr-recruitment",
  "name": "招聘流程",
  "description": "需求确认 → 寻源 → 面试 → 录用审批",
  "steps": {
    "nodes": [
      {
        "id": 1,
        "type": "requirement_confirm",
        "title": "需求确认",
        "position": {
          "x": 80,
          "y": 200
        },
        "engine": "claude",
        "model": "",
        "prompt": "与业务部门确认招聘需求：岗位名称、职级、编制类型（正式/外包/实习）、薪资范围、工作地点、紧急程度。分析岗位画像：必备技能、加分项、软素质要求、团队风格匹配。产出 JD 初稿和招聘计划时间表。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "用人需求",
            "type": "文档",
            "outputs": [
              {
                "name": "JD 文档",
                "type": "Markdown"
              },
              {
                "name": "招聘计划",
                "type": "file"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "JD 文档",
            "type": "Markdown"
          },
          {
            "name": "招聘计划",
            "type": "file"
          }
        ]
      },
      {
        "id": 2,
        "type": "job_posting",
        "title": "职位发布",
        "position": {
          "x": 380,
          "y": 200
        },
        "engine": "hermes",
        "model": "",
        "prompt": "根据审核通过的 JD 多渠道发布职位：招聘网站（Boss直聘/猎聘/拉勾等）、公司官网招聘页、内部推荐系统、LinkedIn/脉脉等社交平台。优化各渠道职位标题和描述以提升搜索曝光率，设置自动刷新策略，配置简历接收规则。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "JD 文档",
            "type": "Markdown",
            "outputs": [
              {
                "name": "发布记录",
                "type": "json"
              },
              {
                "name": "渠道配置",
                "type": "file"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "发布记录",
            "type": "json"
          },
          {
            "name": "渠道配置",
            "type": "file"
          }
        ]
      },
      {
        "id": 3,
        "type": "resume_screening",
        "title": "简历筛选",
        "position": {
          "x": 680,
          "y": 80
        },
        "engine": "claude",
        "model": "",
        "prompt": "对收到的简历进行智能筛选：根据 JD 要求自动匹配关键词和经验年限、分析工作经历的相关性和稳定性、评估项目经验与岗位的匹配度、标记亮点和风险点（频繁跳槽、经历断层等）。产出候选人初筛排序列表和每份简历的评估摘要。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "应聘简历",
            "type": "PDF",
            "outputs": [
              {
                "name": "筛选结果",
                "type": "json"
              },
              {
                "name": "评估摘要",
                "type": "file"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "筛选结果",
            "type": "json"
          },
          {
            "name": "评估摘要",
            "type": "file"
          }
        ]
      },
      {
        "id": 4,
        "type": "phone_screen",
        "title": "电话初筛",
        "position": {
          "x": 680,
          "y": 260
        },
        "engine": "claude",
        "model": "",
        "prompt": "对通过简历筛选的候选人进行电话初筛沟通提纲准备：核实基本信息（当前薪资、离职原因、到岗时间）、评估沟通表达能力和求职动机、确认薪资期望是否在预算范围内。产出初筛评估结果和面试邀约名单。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "筛选结果",
            "type": "json",
            "outputs": [
              {
                "name": "初筛结果",
                "type": "json"
              },
              {
                "name": "面试名单",
                "type": "file"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "初筛结果",
            "type": "json"
          },
          {
            "name": "面试名单",
            "type": "file"
          }
        ]
      },
      {
        "id": 5,
        "type": "interview",
        "title": "面试评估",
        "position": {
          "x": 980,
          "y": 200
        },
        "engine": "claude",
        "model": "",
        "prompt": "组织面试流程并完成评估：生成结构化面试题库（技术能力+行为面试+情景模拟）、协调面试官时间、汇总各轮面试反馈。产出候选人综合评估报告（技能评分、文化匹配度、发展潜力、薪资建议），按推荐度排序。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "初筛结果",
            "type": "json",
            "outputs": [
              {
                "name": "评估报告",
                "type": "file"
              },
              {
                "name": "面试题库",
                "type": "json"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "评估报告",
            "type": "file"
          },
          {
            "name": "面试题库",
            "type": "json"
          }
        ]
      },
      {
        "id": 6,
        "type": "offer_approval",
        "title": "录用审批",
        "position": {
          "x": 1280,
          "y": 200
        },
        "engine": "claude",
        "model": "",
        "prompt": "发起录用审批流程：根据面试评估报告生成 Offer 方案（职级、薪资结构、期权/股权、签字费、试用期安排）、对比市场薪酬数据确保竞争力、按公司审批矩阵逐级提交。产出 Offer 审批单和入职材料清单。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "评估报告",
            "type": "file",
            "outputs": [
              {
                "name": "Offer 方案",
                "type": "json"
              },
              {
                "name": "审批记录",
                "type": "file"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "Offer 方案",
            "type": "json"
          },
          {
            "name": "审批记录",
            "type": "file"
          }
        ]
      },
      {
        "id": 7,
        "type": "onboarding",
        "title": "入职办理",
        "position": {
          "x": 1580,
          "y": 200
        },
        "engine": "hermes",
        "model": "",
        "prompt": "办理新员工入职手续：发送 Offer 邮件并跟踪确认回签、安排入职体检和背景调查、配置办公设备和系统账号权限、制定入职培训计划（公司文化+岗位技能+合规培训）。产出入职清单完成状态和新员工档案。",
        "review": {
          "auto": false,
          "maxRetries": 1,
          "engine": "",
          "model": "",
          "prompt": ""
        },
        "inputs": [
          {
            "name": "Offer 方案",
            "type": "json",
            "outputs": [
              {
                "name": "入职清单",
                "type": "json"
              },
              {
                "name": "员工档案",
                "type": "file"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "入职清单",
            "type": "json"
          },
          {
            "name": "员工档案",
            "type": "file"
          }
        ]
      }
    ],
