<mxfile host="app.diagrams.net" agent="WorkStep architecture" version="24.7.17"><diagram id="overview" name="数字员工整体架构"><mxGraphModel adaptiveColors="auto" page="1" pageScale="1" pageWidth="1420" pageHeight="780"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="project" value="员工项目 / 长期身份与工作空间&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;复用项目、会话、流程、技能与存储；补齐员工配置和可信执行&lt;/font&gt;" style="swimlane;startSize=75;html=1;rounded=1;arcSize=12;container=1;pointerEvents=0;horizontal=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontFamily=Helvetica;fontColor=#1d1d1f;fontSize=18;align=left;spacingLeft=25;" vertex="1" parent="1"><mxGeometry x="280" y="36" width="840" height="684" as="geometry" /></mxCell><mxCell id="owner" value="&lt;b&gt;老板&lt;/b&gt;&lt;br&gt;派活、反馈、批准&lt;br&gt;查看进展与交付&lt;br&gt;&lt;font color=&quot;#424245&quot;&gt;使用者&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f7;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="104" as="geometry" /></mxCell><mxCell id="market" value="&lt;b&gt;员工订阅平台&lt;/b&gt;&lt;br&gt;岗位、技能、流程模板&lt;br&gt;版本、订阅与安装&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;新增&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="220" height="104" as="geometry" /></mxCell><mxCell id="identity" value="&lt;b&gt;岗位与性格&lt;/b&gt;&lt;br&gt;职责、沟通风格、工作方法&lt;br&gt;从角色中心选择并冻结&lt;br&gt;&lt;font color=&quot;#0071e3&quot;&gt;扩展&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="project"><mxGeometry x="40" y="104" width="220" height="104" as="geometry" /></mxCell><mxCell id="capabilities" value="&lt;b&gt;Skills 与工作流&lt;/b&gt;&lt;br&gt;方法、脚本与多步骤执行&lt;br&gt;只加载当次需要的能力&lt;br&gt;&lt;font color=&quot;#0071e3&quot;&gt;已有＋扩展&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="project"><mxGeometry x="320" y="104" width="220" height="104" as="geometry" /></mxCell><mxCell id="memory" value="&lt;b&gt;短记忆&lt;/b&gt;&lt;br&gt;稳定事实、偏好、关键约定&lt;br&gt;容量受限 · 合并替换&lt;br&gt;&lt;font color=&quot;#7c3aed&quot;&gt;已有＋扩展&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="project"><mxGeometry x="600" y="104" width="220" height="104" as="geometry" /></mxCell><mxCell id="chat" value="&lt;b&gt;员工对话与主动入口&lt;/b&gt;&lt;br&gt;老板派活 / 事件或定时唤醒&lt;br&gt;同一身份，多段会话&lt;br&gt;&lt;font color=&quot;#0071e3&quot;&gt;扩展&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="project"><mxGeometry x="40" y="314" width="220" height="104" as="geometry" /></mxCell><mxCell id="context" value="&lt;b&gt;上下文组装&lt;/b&gt;&lt;br&gt;短记忆 + 相关历史 + 技能&lt;br&gt;统一预算、来源、版本&lt;br&gt;&lt;font color=&quot;#7c3aed&quot;&gt;新增／统一&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="project"><mxGeometry x="320" y="314" width="220" height="104" as="geometry" /></mxCell><mxCell id="dispatch" value="&lt;b&gt;判断与能力调度&lt;/b&gt;&lt;br&gt;答复 / 提案 / 派发流程&lt;br&gt;处理阻塞、审核与收尾&lt;br&gt;&lt;font color=&quot;#0071e3&quot;&gt;扩展&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontC