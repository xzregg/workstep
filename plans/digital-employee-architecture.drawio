hModel adaptiveColors="auto" page="1" pageScale="1" pageWidth="1420" pageHeight="780"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="learning-area" value="成长发生在员工项目内&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;原始经历持续累积；记忆与能力变更需要证据、适用范围和版本&lt;/font&gt;" style="swimlane;startSize=75;html=1;rounded=1;arcSize=12;container=1;pointerEvents=0;horizontal=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontFamily=Helvetica;fontColor=#1d1d1f;fontSize=18;align=left;spacingLeft=25;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1380" height="640" as="geometry" /></mxCell><mxCell id="work" value="&lt;b&gt;一次真实工作&lt;/b&gt;&lt;br&gt;需求、执行、测试、审核&lt;br&gt;老板纠正与验收&lt;br&gt;&lt;font color=&quot;#0071e3&quot;&gt;已有&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="20" y="90" width="220" height="104" as="geometry" /></mxCell><mxCell id="evidence" value="&lt;b&gt;完整证据与检索索引&lt;/b&gt;&lt;br&gt;历史原文、反馈、产物&lt;br&gt;保留出处，不全量常驻&lt;br&gt;&lt;font color=&quot;#7c3aed&quot;&gt;已有＋扩展&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="300" y="90" width="220" height="104" as="geometry" /></mxCell><mxCell id="candidate" value="&lt;b&gt;提炼候选经验&lt;/b&gt;&lt;br&gt;适用条件、经验、证据&lt;br&gt;去重、冲突与时效检查&lt;br&gt;&lt;font color=&quot;#7c3aed&quot;&gt;扩展&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="580" y="90" width="220" height="104" as="geometry" /></mxCell><mxCell id="verify" value="&lt;b&gt;验证与分流&lt;/b&gt;&lt;br&gt;直接确认 / 独立结果证据&lt;br&gt;检查范围与有效期&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;新增&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="860" y="90" width="220" height="104" as="geometry" /></mxCell><mxCell id="skilldraft" value="&lt;b&gt;技能 / 流程改进草稿&lt;/b&gt;&lt;br&gt;新方法、脚本、检查步骤&lt;br&gt;差异 + 测试证据&lt;br&gt;&lt;font color=&quot;#0071e3&quot;&gt;新增&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="1140" y="90" width="220" height="104" as="geometry" /></mxCell><mxCell id="next" value="&lt;b&gt;下一次工作&lt;/b&gt;&lt;br&gt;主动采用相关经验&lt;br&gt;继续检查真实效果&lt;br&gt;&lt;font color=&quot;#0071e3&quot;&gt;扩展&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="20" y="310" width="220" height="104" as="geometry" /></mxCell><mxCell id="assemble" value="&lt;b&gt;按任务组装上下文&lt;/b&gt;&lt;br&gt;短记忆 + 相关历史 + 技能&lt;br&gt;统一预算 · 按需继续读&lt;br&gt;&lt;font color=&quot;#7c3aed&quot;&gt;新增／统一&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="300" y="310" width="220" height="104" as="geometry" /></mxCell><mxCell id="short" value="&lt;b&gt;短记忆 · MEMORY.md&lt;/b&gt;&lt;br&gt;偏好、约定、稳定经验&lt;br&gt;固定容量，持续整理&lt;br&gt;&lt;font color=&quot;#7c3aed&quot;&gt;已有＋扩展&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="580" y="310" width="220" height="104" as="geometry" /></mxCell><mxCell id="merge" value="&lt;b&gt;合并与版本记录&lt;/b&gt;&lt;br&gt;新增 / 替换 / 失效&lt;br&gt;容量检查、保留人工约定&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;新增&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="860" y="310" width="220" height="104" as="geometry" /></mxCell><mxCell id="approval" value="&lt;b&gt;评估与老板确认&lt;/b&gt;&lt;br&gt;通过回归与独立案例&lt;br&gt;确认后发布本地版本&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;新增&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="1140" y="310" width="220" height="104" as="geometry" /></mxCell><mxCell id="pending" value="&lt;b&gt;待观察 / 失效 / 淘汰&lt;/b&gt;&lt;br&gt;证据不足、冲突或已过期&lt;br&gt;不进入有效短记忆&lt;br&gt;&lt;font color=&quot;#424245&quot;&gt;新增&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f7;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="580" y="490" width="220" height="104" as="geometry" /></mxCell><mxCell id="version" value="&lt;b&gt;可回滚的能力版本&lt;/b&gt;&lt;br&gt;本地改进与市场基线分离&lt;br&gt;后续工作按需加载&lt;br&gt;&lt;font color=&quot;#0071e3&quot;&gt;新增&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d2d2d7;fontColor=#1d1d1f;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="learning-area"><mxGeometry x="1140" y="490" width="220" height="104" as="geometry" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;endArrow=classic;strokeColor=#0071e3;fo