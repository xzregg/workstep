<mxfile host="app.diagrams.net" type="device"><diagram id="overview" name="全局能力与场景"><mxGraphModel dx="1440" dy="1390" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="1390" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;WorkStep 全局快速决策增强&lt;/b&gt;&lt;br&gt;一次配置 · 按场景启用 · 所有能力均为规划" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="20" width="660" height="80" /></mxCell><mxCell id="chat" value="普通对话 / 渠道消息" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="155" width="295" height="65" /></mxCell><mxCell id="task" value="任务创建 / 定时任务" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="405" y="155" width="295" height="65" /></mxCell><mxCell id="search" value="搜索 / 历史任务" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="740" y="155" width="295" height="65" /></mxCell><mxCell id="ops" value="归档 / 诊断 / 通知" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1075" y="155" width="295" height="65" /></mxCell><mxCell id="p0" value="&lt;b&gt;01 · 优先验证&lt;/b&gt;&lt;br&gt;&lt;br&gt;技能推荐：优先使用哪些技能&lt;br&gt;流程推荐：优先选哪个现有流程&lt;br&gt;搜索重排：哪些已召回结果更相关" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="300" width="410" height="175" /></mxCell><mxCell id="p1" value="&lt;b&gt;02 · 后续验证&lt;/b&gt;&lt;br&gt;&lt;br&gt;上下文推荐 · 输入分类与缺项提示&lt;br&gt;重复任务提示 · 经验候选整理&lt;br&gt;覆盖对话、任务及归档链路" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="515" y="300" width="410" height="175" /></mxCell><mxCell id="p2" value="&lt;b&gt;03 · 实验场景&lt;/b&gt;&lt;br&gt;&lt;br&gt;角色 / 专家团推荐&lt;br&gt;失败类型归类 · 通知重要程度&lt;br&gt;先评估，再决定是否接入" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="300" width="410" height="175" /></mxCell><mxCell id="service" value="&lt;b&gt;WorkStep 共用快速决策服务&lt;/b&gt;&lt;br&gt;&lt;br&gt;Choice · 有限选项选择　/　Noul · 条件判断　/　Score · 按量表评分&lt;br&gt;各供应商分别验证实际支持能力；候选及文本有界、权限预先过滤&lt;br&gt;异步调用 · 结果校验 · 超时及故障隔离 · 记录应用 / 跳过原因" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="255" y="560" width="930" height="150" /></mxCell><mxCell id="svc-p0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0" target="service"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="svc-p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="service"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="svc-p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="service"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="settings" value="&lt;b&gt;设置：快速决策增强&lt;/b&gt;&lt;br&gt;总开关 + 各场景开关&lt;br&gt;默认关闭 · 选择供应商及模型" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="775" width="360" height="110" /></mxCell><mxCell id="local" value="&lt;b&gt;Laya · 本地部署&lt;/b&gt;&lt;br&gt;http://127.0.0.1:6000&lt;br&gt;multilingual · daemon 发起请求" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="775" width="400" height="110" /></mxCell><mxCell id="cloud" value="&lt;b&gt;TypeSafe Jev · 远程供应商&lt;/b&gt;&lt;br&gt;用户明确选择后调用&lt;br&gt;不因本地失败自动切换云端" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="955" y="775" width="415" height="110" /></mxCell><mxCell id="cfg" value="配置" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.75;" edge="1" parent="1" source="settings" target="service"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="180" y="735" /><mxPoint x="210" y="735" /></Array></mxGeometry></mxCell><mxCell id="l" value="所选供应商" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.48;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="service" target="local"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="result" value="&lt;b&gt;返回结构化建议&lt;/b&gt;&lt;br&gt;候选 ID / 排序 / 分类 / 评分&lt;br&gt;分数不能直接当作统一的正确率" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="960" width="400" height="105" /></mxCell><mxCell id="lr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="local" target="result"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="cr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="cloud" target="result"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1160" y="1012" /></Array></mxGeometry></mxCell><mxCell id="apply" value="&lt;b&gt;业务模块采用建议，继续原有流程&lt;/b&gt;&lt;br&gt;完整候选、用户明确选择、现有生成模型与 fast_model 保留&lt;br&gt;操作权限、执行规则与审批仍由原有链路处理" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="335" y="1135" width="770" height="110" /></mxCell><mxCell id="ra" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="result" target="apply"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="foot" value="落地顺序：共用服务与评估 → 技能推荐 → 流程推荐 → 搜索重排&lt;br&gt;预期收益需验证：命中率、误推荐率、端到端耗时及 token；重排本身不提供语义召回" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="255" y="1305" width="930" height="75" /></mxCell><mxCell id="entrybus" value="各业务按需接入已启用的场景 · 不限定助手类型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#526079;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="245" width="1300" height="30" /></mxCell><mxCell id="in1" source="chat" target="entrybus" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.1135;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="in2" source="task" target="entrybus" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.3712;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="in3" source="search" target="entrybus" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.6288;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="in4" source="ops" target="entrybus" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.8865;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="out1" source="entrybus" target="p0" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;exitX=0.1577;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="out2" source="entrybus" target="p1" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="out3" source="entrybus" target="p2" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;exitX=0.8423;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="runtime" name="调用与故障回退"><mxGraphModel dx="1440" dy="1390" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="1390" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;任一业务场景的前台调用与回退&lt;/b&gt;&lt;br&gt;300 ms 为增强阶段总预算；后台场景另设预算" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="20" width="760" height="80" /></mxCell><mxCell id="start" value="业务原有入口&lt;br&gt;聊天 / 任务 / 搜索等" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="455" y="150" width="400" height="75" /></mxCell><mxCell id="enabled" value="总开关与场景开关开启&lt;br&gt;且供应商配置有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="515" y="270" width="280" height="120" /></mxCell><mxCell id="prepare" value="复用现有规则准备有限候选&lt;br&gt;权限过滤 · 保留用户明确选择" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="455" y="440" width="400" height="85" /></mxCell><mxCell id="ready" value="有候选、请求名额&lt;br&gt;且未处于熔断期？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="515" y="570" width="280" height="120" /></mxCell><mxCell id="call" value="异步调用所选 Jev / Laya&lt;br&gt;&lt;b&gt;增强阶段总预算 ≤ 300 ms&lt;/b&gt;&lt;br&gt;最多 2 个并发 / 供应商 · 本轮不重试" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="455" y="745" width="400" height="105" /></mxCell><mxCell id="check" value="响应及时且有效&lt;br&gt;候选 ID / 分数合法？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="515" y="900" width="280" height="120" /></mxCell><mxCell id="suggest" value="向业务提供推荐 / 分类 / 排序&lt;br&gt;仅应用于当前请求及当前配置" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="455" y="1070" width="400" height="80" /></mxCell><mxCell id="continue" value="&lt;b&gt;继续原有业务流程&lt;/b&gt;&lt;br&gt;有建议则参考；无建议按原行为完成" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1240" width="450" height="85" /></mxCell><mxCell id="skip" value="&lt;b&gt;跳过增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;关闭 / 未配置 / 禁用或删除&lt;br&gt;无候选 / 并发已满 / 熔断暂停&lt;br&gt;断网 / 超时 / 鉴权失败 / 无效响应" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="545" width="340" height="195" /></mxCell><mxCell id="breaker" value="故障隔离&lt;br&gt;连续失败 3 次 → 暂停 60 秒&lt;br&gt;到期单次探测 · 不切换云端" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="855" width="340" height="100" /></mxCell><mxCell id="cancel" value="&lt;b&gt;用户停止&lt;/b&gt;&lt;br&gt;取消增强及整个请求&lt;br&gt;不继续生成回复" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="745" width="300" height="105" /></mxCell><mxCell id="notes" value="&lt;b&gt;适配边界&lt;/b&gt;&lt;br&gt;技能：保留已启用列表&lt;br&gt;流程：不覆盖显式选择&lt;br&gt;搜索：原召回与排序可回退&lt;br&gt;通知：不阻塞、不丢弃原通知" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=16;fontFamily=Helvetica;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1050" width="300" height="180" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="enabled"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="enabled" target="prepare"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="prepare" target="ready"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ready" target="call"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="call" target="check"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="check" target="suggest"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="suggest" target="continue"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="off" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ea580c;strokeWidth=2;fontColor=#ea580c;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="enabled" target