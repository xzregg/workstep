<mxGraphModel dx="1200" dy="1460" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1460" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="setup" value="① 供应商中心&lt;br&gt;&lt;b&gt;TypeSafe Jev / 本地 Laya&lt;/b&gt;&lt;br&gt;独立 systemone 决策协议" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="30" width="310" height="100" /></mxCell><mxCell id="toggle" value="② 助手设置 · 任务协调助手&lt;br&gt;&lt;b&gt;资料推荐增强：默认关闭&lt;/b&gt;&lt;br&gt;选择供应商 / 模型 · 连接测试" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="435" y="30" width="340" height="100" /></mxCell><mxCell id="start" value="用户向协调助手提问" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="455" y="190" width="300" height="60" /></mxCell><mxCell id="context" value="准备当前任务上下文与完整产物索引&lt;br&gt;&lt;b&gt;保留现有资料访问能力&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="435" y="290" width="340" height="80" /></mxCell><mxCell id="gate" value="增强已启用&lt;br&gt;且配置有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="495" y="410" width="220" height="110" /></mxCell><mxCell id="candidate" value="构建候选 · 最多 20 个&lt;br&gt;当前问题 + 任务标题 + 产物元数据&lt;br&gt;优先最新成功轮次 · 不读取文件正文" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#818cf8;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="435" y="570" width="340" height="100" /></mxCell><mxCell id="limit" value="可立即获得请求名额&lt;br&gt;且未处于熔断期？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="495" y="715" width="220" height="110" /></mxCell><mxCell id="request" value="异步调用 Jev / Laya&lt;br&gt;&lt;b&gt;增强阶段总预算 ≤ 300 ms&lt;/b&gt;&lt;br&gt;每供应商最多 2 个并发 · 本轮不重试" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="435" y="875" width="340" height="100" /></mxCell><mxCell id="valid" value="响应有效&lt;br&gt;且在时限内？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="495" y="1020" width="220" height="110" /></mxCell><mxCell id="hint" value="添加至多 3 个优先查看建议&lt;br&gt;校验真实产物 ID · 分数仅用于排序" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="435" y="1180" width="340" height="80" /></mxCell><mxCell id="main" value="主模型按现有流程回答 / 读取资料&lt;br&gt;&lt;b&gt;原有完整索引、操作权限与审批保持有效&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="1330" width="410" height="85" /></mxCell><mxCell id="local" value="本地 Laya 默认配置&lt;br&gt;&lt;b&gt;http://127.0.0.1:6000&lt;/b&gt;&lt;br&gt;模型：multilingual&lt;br&gt;地址由 daemon 访问" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="190" width="310" height="115" /></mxCell><mxCell id="skip" value="&lt;b&gt;直接跳过增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;未配置 / 关闭 / 被禁用或删除&lt;br&gt;并发已满 / 熔断暂停&lt;br&gt;断网 / 超时 / 鉴权失败&lt;br&gt;响应无效" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="890" y="690" width="260" height="190" /></mxCell><mxCell id="breaker" value="故障隔离&lt;br&gt;连续失败 3 次 → 暂停 60 秒&lt;br&gt;到期单次探测 · 不切换云端" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fdba74;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="890" y="960" width="260" height="100" /></mxCell><mxCell id="cancel" value="用户停止对话&lt;br&gt;&lt;b&gt;取消增强及整个回合&lt;/b&gt;&lt;br&gt;不进入故障回退继续回答" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#172033;fontSize=15;fontFamily=Helvetica;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="870" width="310" height="100" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="setup" target="toggle"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=13;