<mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="1120">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="third" value="第三方系统" style="text;html=1;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="gateway" value="WorkStep 网关" style="text;html=1;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="160" height="60" as="geometry"/></mxCell>
    <mxCell id="branches" value="登录与错误处理" style="text;html=1;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="160" height="60" as="geometry"/></mxCell>
    <mxCell id="start" value="用户点击登录&lt;br&gt;后端保存随机&lt;br&gt;state 与 request_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="validate" value="检查完整回调 URL&lt;br&gt;HTTP / HTTPS 白名单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="invalid" value="网关显示错误&lt;br&gt;不跳往未授权地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="160" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="session" value="已登录且账号有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="160" height="90" as="geometry"/></mxCell>
    <mxCell id="login" value="现有密码 / 企业扫码&lt;br&gt;登录后恢复请求&lt;br&gt;待审批账号先审批" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="code" value="签发 code&lt;br&gt;绑定 request_id 摘要&lt;br&gt;两分钟有效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="callback" value="浏览器回到 callback&lt;br&gt;仅追加 code + state&lt;br&gt;不回传 request_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="state" value="后端核验 state&lt;br&gt;从当前登录会话&lt;br&gt;取出 request_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="exchange" value="POST /api/auth/exchange&lt;br&gt;code + request_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="640" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="check" value="匹配、有效、未消费？&lt;br&gt;账号 / 白名单有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="760" width="160" height="90" as="geometry"/></mxCell>
    <mxCell id="failure" value="返回错误&lt;br&gt;第三方重新发起登录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="760" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="consume" value="原子消费 code&lt;br&gt;仅一次兑换成功&lt;br&gt;返回用户基本信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="880" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="done" value="按网关用户 ID 关联&lt;br&gt;建立本系统登录会话&lt;br&gt;清理回调地址的 code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="e1" value="浏览器跳转&lt;br&gt;callback / state / request_id" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="start" target="validate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" value="未获授权" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="validate" target="invalid" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" value="通过" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="validate" target="session" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" value="未登录" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="session" target="login" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="session" target="code" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" value="登录成功" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="login" target="code" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" value="自动回跳" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="code" target="callback" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="callback" target="state" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e9" value="后端请求网关" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="state" target="exchange" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="exchange" target="check" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e11" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="check" target="failure" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e12" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="check" target="consume" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e13" value="id / username / display_name" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=default;" edge="1" source="consume" target="done" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
