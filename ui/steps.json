{
  "steps": [
    { "key": "req", "label": "需求", "color": "#0071e3", "engine": "claude", "model": "", "prompt": "根据业务需求和用户调研，产出 PRD 文档和原型图。明确用户场景、功能点、验收标准。", "inputs": [{"name":"业务需求","type":"文档"},{"name":"用户调研","type":"PDF"}], "outputs": [{"name":"PRD 文档","type":"Markdown"},{"name":"原型图","type":"Figma"}], "dependsOn": [] },
    { "key": "ui", "label": "UI 设计", "color": "#7c3aed", "engine": "claude", "model": "", "prompt": "根据 PRD 和原型图，设计高保真 UI 界面，产出设计稿和设计规范文档。", "inputs": [{"name":"PRD 文档","type":"Markdown"},{"name":"原型图","type":"Figma"}], "outputs": [{"name":"UI 设计稿","type":"Figma"},{"name":"设计规范","type":"PDF"}], "dependsOn": ["req"] },
    { "key": "frontend", "label": "前端开发", "color": "#059669", "engine": "claude", "model": "", "prompt": "根据 UI 设计稿和接口文档，开发前端页面，实现状态管理和单元测试。", "inputs": [{"name":"UI 设计稿","type":"Figma"},{"name":"接口文档","type":"JSON"},{"name":"组件库","type":"React"}], "outputs": [{"name":"前端页面","type":"React"},{"name":"状态管理","type":"Zustand"},{"name":"单元测试","type":"Vitest"}], "dependsOn": ["ui"] },
    { "key": "backend", "label": "后端开发", "color": "#d97706", "engine": "codex", "model": "gpt-5.5", "prompt": "根据 PRD 和接口文档，开发后端 API 服务，设计数据库表结构。", "inputs": [{"name":"PRD 文档","type":"Markdown"},{"name":"接口文档","type":"JSON"}], "outputs": [{"name":"API 服务","type":"Go"},{"name":"数据库","type":"MySQL"}], "dependsOn": ["ui"] },
    { "key": "test", "label": "测试", "color": "#dc2626", "engine": "codex", "model": "", "prompt": "对前端页面和后端 API 进行集成测试，产出测试报告和 Bug 列表。", "inputs": [{"name":"前端页面","type":"React"},{"name":"API 服务","type":"Go"}], "outputs": [{"name":"测试报告","type":"HTML"},{"name":"Bug 列表","type":"Excel"}], "dependsOn": ["frontend", "backend"] },
    { "key": "deploy", "label": "上线", "color": "#16a34a", "engine": "hermes", "model": "grok-4.3", "prompt": "根据测试报告和部署文档，将服务部署到生产环境。", "inputs": [{"name":"测试报告","type":"HTML"},{"name":"部署文档","type":"Markdown"}], "outputs": [{"name":"生产环境","type":"K8s"}], "dependsOn": ["test"] }
  ]
}
